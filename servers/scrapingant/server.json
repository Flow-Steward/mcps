{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.flow-steward/scrapingant",
  "title": "ScrapingAnt",
  "description": "Fetch web pages as HTML, Markdown or plain text with optional browser rendering, residential proxies, and country-specific proxy routing.",
  "version": "1.0.0",
  "websiteUrl": "https://scrapingant.com",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.scrapingant.com/mcp",
      "headers": [
        {
          "name": "x-api-key",
          "description": "Your ScrapingAnt dashboard API key.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
